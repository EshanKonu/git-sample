<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_location_tag_view_form" model="ir.ui.view">
        <field name="name">drbb.location.tag.view.form</field>
        <field name="model">drbb.location.tag</field>
        <field name="arch" type="xml">
            <form string="Location Tags">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_location_tag_view_list" model="ir.ui.view">
        <field name="name">drbb.location.tag.view.list</field>
        <field name="model">drbb.location.tag</field>
        <field name="arch" type="xml">
            <list string="Location Tags">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_location_tag_view_search" model="ir.ui.view">
        <field name="name">drbb.location.tag.search</field>
        <field name="model">drbb.location.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_drbb_location_tag" model="ir.actions.act_window">
        <field name="name">Location Tags</field>
        <field name="res_model">drbb.location.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
