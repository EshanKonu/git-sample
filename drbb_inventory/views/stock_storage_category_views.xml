<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_inventory_stock_storage_category_form" model="ir.ui.view">
        <field name="name">drbb.inventory.stock.storage.category.form</field>
        <field name="model">stock.storage.category</field>
        <field name="inherit_id" ref="stock.stock_storage_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group/field[@name='company_id']" position="before">
                <label for="max_volume"/>
                <div class="o_row">
                    <field name="max_volume" class="oe_inline"/>
                    <field name="volume_uom_name" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="drbb_inventory_stock_storage_category_tree" model="ir.ui.view">
        <field name="name">drbb.inventory.stock.storage.category.list</field>
        <field name="model">stock.storage.category</field>
        <field name="inherit_id" ref="stock.stock_storage_category_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='max_weight']" position="after">
                <field name="max_volume" string="Max Volume"/>
            </xpath>
        </field>
    </record>
</odoo>