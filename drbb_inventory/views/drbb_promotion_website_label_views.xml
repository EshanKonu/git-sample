<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_promotion_website_label_view_form" model="ir.ui.view">
        <field name="name">drbb.promotion.website.label.view.form</field>
        <field name="model">drbb.promotion.website.label</field>
        <field name="arch" type="xml">
            <form string="Promotion Website Labels">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_promotion_website_label_view_list" model="ir.ui.view">
        <field name="name">drbb.promotion.website.label.view.list</field>
        <field name="model">drbb.promotion.website.label</field>
        <field name="arch" type="xml">
            <list string="Promotion Website Labels">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_promotion_website_label_view_search" model="ir.ui.view">
        <field name="name">drbb.promotion.website.label.search</field>
        <field name="model">drbb.promotion.website.label</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_drbb_promotion_website_label" model="ir.actions.act_window">
        <field name="name">Promotion Website Labels</field>
        <field name="res_model">drbb.promotion.website.label</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
