<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_stock_reported_issue_view_list" model="ir.ui.view">
        <field name="name">drbb.stock.reported.issue.view.list</field>
        <field name="model">drbb.stock.reported.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="batch_id"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="issue_type_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="drbb_stock_reported_issue_view_form" model="ir.ui.view">
        <field name="name">drbb.stock.reported.issue.view.form</field>
        <field name="model">drbb.stock.reported.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_new" type="object" string="Mark New"
                            invisible="state == 'new'"/>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id"/>
                            <field name="issue_type_id" required="1"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="location_id"/>
                            <field name="remark"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_stock_reported_issue_simple_view_form" model="ir.ui.view">
        <field name="name">drbb.stock.reported.issue.view.form</field>
        <field name="model">drbb.stock.reported.issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                            <field name="issue_type_id" required="1"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="picking_id" readonly="1"/>
                            <field name="remark"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_drbb_stock_reported_issue" model="ir.actions.act_window">
        <field name="name">Reported Issues</field>
        <field name="res_model">drbb.stock.reported.issue</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No reported issues yet.
            </p>
        </field>
    </record>
</odoo>
