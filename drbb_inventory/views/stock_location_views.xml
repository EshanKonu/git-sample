<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_inventory_view_location_form" model="ir.ui.view">
        <field name="name">drbb.inventory.stock.location.form</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='next_inventory_date']" position="after">
                <field name="avg_picking_time" widget="float_time"/>
                <field name="location_tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='is_a_dock']" position="after">
                <field name="is_circuit"/>
                <field name="is_reserve"/>
            </xpath>
        </field>
    </record>

    <record id="drbb_inventory_view_location_tree2" model="ir.ui.view">
        <field name="name">drbb.inventory.view.location.tree2</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='storage_category_id']" position="after">
                <field name="location_tag_ids" widget="many2many_tags" optional="hide"/>
                <field name="removal_prio" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="drbb_inventory_view_location_search" model="ir.ui.view">
        <field name="name">drbb.inventory.view.location.search</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="location_tag_ids" string="Tags"/>
            </xpath>
            <xpath expr="//filter[@name='usage']" position="after">
                <filter string="Tags" name="location_tag" context="{'group_by': 'location_tag_ids'}"/>
            </xpath>
        </field>
    </record>

    <record id="stock_location_view_map" model="ir.ui.view">
        <field name="name">stock.location.view.map</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <map res_partner="partner_id"/>
        </field>
    </record>

    <record id="stock_location_action_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock.view_location_tree2"/>
        <field name="act_window_id" ref="stock.action_location_form"/>
    </record>

    <record id="stock_location_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock.view_location_form"/>
        <field name="act_window_id" ref="stock.action_location_form"/>
    </record>

    <record id="stock_location_action_view_map" model="ir.actions.act_window.view">
        <field name="view_mode">map</field>
        <field name="view_id" ref="stock_location_view_map"/>
        <field name="act_window_id" ref="stock.action_location_form"/>
    </record>
</odoo>