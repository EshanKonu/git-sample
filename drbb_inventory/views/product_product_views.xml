<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_view_form_easy_inherit_drbb_inventory" model="ir.ui.view">
        <field name="name">product.product</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="extra_info" string="Extra Info">
                    <field name="item_status_id"/>
                </group>
            </xpath>
            <xpath expr="//div[field[@name='lst_price']]" position="after">
                <label for="recommended_retail_price"/>
                <div class="o_row">
                    <field name="recommended_retail_price" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cs_item_number']" position="after">
                <field name="item_status_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_product_variants" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="context">{"search_default_filter_to_sell":1}</field>
        <field name="view_id" ref="product.product_product_tree_view"/>
        <field name="search_view_id" ref="product.product_search_form_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product variant
            </p><p>
            You must define a product for everything you sell, whether it's a physical product,
            a consumable or a service you offer to customers.
            The product form contains information to simplify the sale process:
            price, notes in the quotation, accounting data, procurement methods, etc.
        </p>
        </field>
    </record>
</odoo>
