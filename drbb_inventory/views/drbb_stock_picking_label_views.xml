<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_stock_picking_label_view_form" model="ir.ui.view">
        <field name="name">drbb.stock.picking.label.view.form</field>
        <field name="model">drbb.stock.picking.label</field>
        <field name="arch" type="xml">
            <form string="Stock Transfer Labels">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_stock_picking_label_view_list" model="ir.ui.view">
        <field name="name">drbb.stock.picking.label.view.list</field>
        <field name="model">drbb.stock.picking.label</field>
        <field name="arch" type="xml">
            <list string="Stock Transfer Labels">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_stock_picking_label_view_search" model="ir.ui.view">
        <field name="name">drbb.stock.picking.label.search</field>
        <field name="model">drbb.stock.picking.label</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="drbb_stock_picking_label_action" model="ir.actions.act_window">
        <field name="name">Stock Transfer Labels</field>
        <field name="res_model">drbb.stock.picking.label</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
