<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drbb_inventory_stock_quant_package_view_form" model="ir.ui.view">
        <field name="name">drbb.inventory.stock.quant.package.view.form</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock_barcode_picking_batch.view_quant_package_form_inherit_stock_barcode_picking_batch"/>
        <field name="arch" type="xml">
            <field name="package_use" position="after">
                <field name="package_zone_id" widget="selection"/>
                <field name="qty_in_package" invisible="1"/>
                <field name="source_location_barcode" invisible="1"/>
                <field name="dest_location_barcode" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
