<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_product_stage_view_form" model="ir.ui.view">
        <field name="name">drbb.product.stage.view.form</field>
        <field name="model">drbb.product.stage</field>
        <field name="arch" type="xml">
            <form string="Product Stage Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_product_stage_view_list" model="ir.ui.view">
        <field name="name">drbb.product.stage.view.list</field>
        <field name="model">drbb.product.stage</field>
        <field name="arch" type="xml">
            <list string="Product Stage Rule">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_product_stage_view_search" model="ir.ui.view">
        <field name="name">drbb.product.stage.search</field>
        <field name="model">drbb.product.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_drbb_product_stage" model="ir.actions.act_window">
        <field name="name">Product Stage</field>
        <field name="res_model">drbb.product.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
