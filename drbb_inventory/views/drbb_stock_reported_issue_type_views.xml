<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_stock_reported_issue_type_view_list" model="ir.ui.view">
        <field name="name">drbb.stock.reported.issue.type.view.list</field>
        <field name="model">drbb.stock.reported.issue.type</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_stock_reported_issue_type_view_form" model="ir.ui.view">
        <field name="name">drbb.stock.reported.issue.type.view.form</field>
        <field name="model">drbb.stock.reported.issue.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_drbb_stock_reported_issue_type" model="ir.actions.act_window">
        <field name="name">Reported Issue Types</field>
        <field name="res_model">drbb.stock.reported.issue.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No reported issue types yet.
            </p>
        </field>
    </record>
</odoo>
