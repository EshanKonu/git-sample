<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_product_abc_class_view_form" model="ir.ui.view">
        <field name="name">drbb.product.abc.class.view.form</field>
        <field name="model">drbb.product.abc.class</field>
        <field name="arch" type="xml">
            <form string="Product Abc Class">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_product_abc_class_view_list" model="ir.ui.view">
        <field name="name">drbb.product.abc.class.view.list</field>
        <field name="model">drbb.product.abc.class</field>
        <field name="arch" type="xml">
            <list string="Product Abc Class">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_product_abc_class_view_search" model="ir.ui.view">
        <field name="name">drbb.product.abc.class.search</field>
        <field name="model">drbb.product.abc.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_drbb_product_abc_class" model="ir.actions.act_window">
        <field name="name">Product Abc Class</field>
        <field name="res_model">drbb.product.abc.class</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
