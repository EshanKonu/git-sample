<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_product_brand_view_form" model="ir.ui.view">
        <field name="name">drbb.product.brand.view.form</field>
        <field name="model">drbb.product.brand</field>
        <field name="arch" type="xml">
            <form string="Product Brand">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="drbb_product_brand_view_list" model="ir.ui.view">
        <field name="name">drbb.product.brand.view.list</field>
        <field name="model">drbb.product.brand</field>
        <field name="arch" type="xml">
            <list string="Product Brand" editable="top">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="drbb_product_brand_view_search" model="ir.ui.view">
        <field name="name">drbb.product.brand.search</field>
        <field name="model">drbb.product.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_drbb_product_brand" model="ir.actions.act_window">
           <field name="name">Product Brands</field>
           <field name="res_model">drbb.product.brand</field>
           <field name="view_mode">list,form</field>
       </record>
</odoo>
