<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_picking_priority_rule_view_form" model="ir.ui.view">
        <field name="name">drbb.picking.priority.rule.view.form</field>
        <field name="model">drbb.picking.priority.rule</field>
        <field name="arch" type="xml">
            <form string="Picking Priority Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="picking_weight"/>
                        </group>
                    </group>
                    <separator/>
                    <group string="Filters">
                        <group>
                            <field name="source_sale_order"/>
                            <field name="promotion"/>
                        </group>
                        <group>
                            <field name="pick_to_clean"/>
                            <field name="product_category_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="drbb_picking_priority_rule_view_list" model="ir.ui.view">
        <field name="name">drbb.picking.priority.rule.view.list</field>
        <field name="model">drbb.picking.priority.rule</field>
        <field name="arch" type="xml">
            <list string="Picking Priority Rule">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="picking_weight"/>
            </list>
        </field>
    </record>

    <record id="drbb_picking_priority_rule_view_search" model="ir.ui.view">
        <field name="name">drbb.picking.priority.rule.search</field>
        <field name="model">drbb.picking.priority.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="action_drbb_picking_priority_rule" model="ir.actions.act_window">
           <field name="name">Picking Priority Rule</field>
           <field name="res_model">drbb.picking.priority.rule</field>
           <field name="view_mode">list,form</field>
       </record>
</odoo>
