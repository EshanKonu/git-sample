<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drbb_inventory_ready_to_pick_mail_template" model="mail.template">
        <field name="name">Inventory: Ready for Pick-up</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="subject">{{ object.sale_id.company_id.name }} Delivery Order (Ref {{ object.sale_id.name or 'n/a' }})</field>
        <field name="partner_to">{{ object.sale_id.partner_id.email and object.sale_id.partner_id.id or object.sale_id.partner_id.parent_id.id }}</field>
        <field name="description">Sent to the customers when orders are ready to pickup</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear Customer,<br/><br/>
                    Goods news! Your order can now be collected at Dreambaby.<br/><br/>
                    Your package will remain available for you for the next 5 working days.<br/><br/>
                    Kind Regards.<br/><br/>
                </p>
            </div>
            <br/>
            <br/>
            <t t-if="object.sale_id">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 12px;">
                        Hello,
                        <br/><br/>
                        <t t-set="tx_sudo" t-value="object.sale_id.get_portal_last_transaction()"/>
                        Your order <span style="font-weight:bold;" t-out="object.sale_id.name or ''">S00049</span> amounting in <span style="font-weight:bold;" t-out="format_amount(object.sale_id.amount_total, object.sale_id.currency_id) or ''">$ 10.00</span>
                        <t t-if="object.sale_id.state == 'sale' or (tx_sudo and tx_sudo.state in ('done', 'authorized'))">
                            has been confirmed.<br/>
                            Thank you for your trust!
                        </t>
                        <t t-elif="tx_sudo and tx_sudo.state == 'pending'">
                            is pending. It will be confirmed when the payment is received.
                            <t t-if="object.sale_id.reference">
                                Your payment reference is <span style="font-weight:bold;" t-out="object.sale_id.reference or ''"></span>.
                            </t>
                        </t>
                        <br/>
                        <t t-set="documents" t-value="object.sale_id._get_product_documents()"/>
                        <t t-if="documents">
                            <br/>
                            <t t-if="len(documents)>1">
                                Here are some additional documents that may interest you:
                            </t>
                            <t t-else="">
                                Here is an additional document that may interest you:
                            </t>
                            <ul style="margin-bottom: 0;">
                                <t t-foreach="documents" t-as="document">
                                    <li style="font-size: 13px;">
                                        <a t-out="document.ir_attachment_id.name"
                                           t-att-href="object.sale_id.get_portal_url('/document/' + str(document.id))"
                                           t-att-target="target"/>
                                    </li>
                                </t>
                            </ul>
                        </t>
                        <br/>
                        Do not hesitate to contact us if you have any questions.
                        <t t-if="not is_html_empty(object.sale_id.user_id.signature)">
                            <br/><br/>
                            <t t-out="object.sale_id.user_id.signature or ''">--<br/>Mitchell Admin</t>
                        </t>
                        <br/><br/>
                    </p>
                    <t t-if="hasattr(object.sale_id, 'website_id') and object.sale_id.website_id">
                        <div style="margin: 0px; padding: 0px;">
                            <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse; white-space: nowrap;">
                                <tr style="border-bottom: 2px solid #dee2e6;">
                                    <td style="width: 150px;"><span style="font-weight:bold;">Products</span></td>
                                    <td></td>
                                    <td width="15%" align="center"><span style="font-weight:bold;">Quantity</span></td>
                                    <td width="20%" align="right">
                                        <span style="font-weight:bold;">
                                            <t t-if="object.sale_id.website_id.show_line_subtotals_tax_selection == 'tax_excluded'">
                                                Tax Excl.
                                            </t>
                                            <t t-else="">
                                                Tax Incl.
                                            </t>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-foreach="object.sale_id.order_line" t-as="line">
                                <t
                                        t-set="line_subtotal"
                                        t-value="
                    line.price_subtotal
                    if object.sale_id.website_id.show_line_subtotals_tax_selection == 'tax_excluded'
                    else line.price_total
                "
                                />
                                <t t-set="current_subtotal" t-value="current_subtotal + line_subtotal"/>
                                <t
                                        t-if="(not hasattr(line, 'is_delivery') or not line.is_delivery) and (
                    line.display_type in ['line_section', 'line_note']
                    or line.product_type == 'combo'
                )"
                                >
                                    <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                                        <t t-set="loop_cycle_number" t-value="loop_cycle_number or 0" />
                                        <tr t-att-style="'background-color: #f2f2f2' if loop_cycle_number % 2 == 0 else 'background-color: #ffffff'">
                                            <t t-set="loop_cycle_number" t-value="loop_cycle_number + 1" />
                                            <td colspan="4">
                                                <t t-if="line.display_type == 'line_section' or line.product_type == 'combo'">
                                                    <span style="font-weight:bold;" t-out="line.name or ''">Taking care of Trees Course</span>
                                                    <t t-set="current_section" t-value="line"/>
                                                    <t t-set="current_subtotal" t-value="0"/>
                                                </t>
                                                <t t-elif="line.display_type == 'line_note'">
                                                    <i t-out="line.name or ''">Taking care of Trees Course</i>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                                <t t-elif="(not hasattr(line, 'is_delivery') or not line.is_delivery)">
                                    <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                                        <t t-set="loop_cycle_number" t-value="loop_cycle_number or 0" />
                                        <tr t-att-style="'background-color: #f2f2f2' if loop_cycle_number % 2 == 0 else 'background-color: #ffffff'">
                                            <t t-set="loop_cycle_number" t-value="loop_cycle_number + 1" />
                                            <td style="width: 150px;">
                                                <img t-attf-src="/web/image/product.product/{{ line.product_id.id }}/image_128" style="width: 64px; height: 64px; object-fit: contain;" alt="Product image"></img>
                                            </td>
                                            <td align="left" t-out="line.product_id.name or ''">	Taking care of Trees Course</td>
                                            <td width="15%" align="center" t-out="line.product_uom_qty or ''">1</td>
                                            <td width="20%" align="right"><span style="font-weight:bold; white-space: nowrap;">
                                                <t t-if="object.sale_id.website_id.show_line_subtotals_tax_selection == 'tax_excluded'">
                                                    <t t-out="format_amount(line.price_reduce_taxexcl, object.sale_id.currency_id) or ''">$ 10.00</t>
                                                </t>
                                                <t t-else="">
                                                    <t t-out="format_amount(line.price_reduce_taxinc, object.sale_id.currency_id) or ''">$ 10.00</t>
                                                </t>
                                            </span></td>
                                        </tr>
                                    </table>
                                </t>
                                <t
                                        t-if="current_section and (
                    line_last
                    or object.sale_id.order_line[line_index+1].display_type == 'line_section'
                    or object.sale_id.order_line[line_index+1].product_type == 'combo'
                    or (
                        line.combo_item_id
                        and not object.sale_id.order_line[line_index+1].combo_item_id
                    )
                ) and not line.is_downpayment"
                                >
                                    <t t-set="current_section" t-value="None"/>
                                    <table width="100%" style="color: #454748; font-size: 12px; border-collapse: collapse;">
                                        <t t-set="loop_cycle_number" t-value="loop_cycle_number or 0"/>
                                        <tr t-att-style="'background-color: #f2f2f2' if loop_cycle_number % 2 == 0 else 'background-color: #ffffff'">
                                            <t t-set="loop_cycle_number" t-value="loop_cycle_number + 1"/>
                                            <td style="width: 100%" align="right">
                                                <span style="font-weight: bold;">Subtotal:</span>
                                                <span t-out="format_amount(current_subtotal, object.sale_id.currency_id) or ''">$ 10.00</span>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                            </t>
                        </div>
                        <div style="margin: 0px; padding: 0px;" t-if="hasattr(object, 'carrier_id') and object.sale_id.carrier_id">
                            <table width="100%" style="color: #454748; font-size: 12px; border-spacing: 0px 4px; white-space: nowrap;" align="right">
                                <tr>
                                    <td style="width: 60%"/>
                                    <td style="width: 30%; border-top: 1px solid #dee2e6;" align="right"><span style="font-weight:bold;">Delivery:</span></td>
                                    <td style="width: 10%; border-top: 1px solid #dee2e6;" align="right" t-out="format_amount(object.sale_id.amount_delivery, object.sale_id.currency_id) or ''">$ 0.00</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%"/>
                                    <td style="width: 30%;" align="right"><span style="font-weight:bold;">Untaxed Amount:</span></td>
                                    <td style="width: 10%;" align="right" t-out="format_amount(object.sale_id.amount_untaxed, object.sale_id.currency_id) or ''">$ 10.00</td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin: 0px; padding: 0px;" t-else="">
                            <table width="100%" style="color: #454748; font-size: 12px; border-spacing: 0px 4px; white-space: nowrap;" align="right">
                                <tr>
                                    <td style="width: 60%"/>
                                    <td style="width: 30%; border-top: 1px solid #dee2e6;" align="right"><span style="font-weight:bold;">Untaxed Amount:</span></td>
                                    <td style="width: 10%; border-top: 1px solid #dee2e6;" align="right" t-out="format_amount(object.sale_id.amount_untaxed, object.sale_id.currency_id) or ''">$ 10.00</td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin: 0px; padding: 0px;">
                            <table width="100%" style="color: #454748; font-size: 12px; border-spacing: 0px 4px; white-space: nowrap;" align="right">
                                <tr>
                                    <td style="width: 60%"/>
                                    <td style="width: 30%;" align="right"><span style="font-weight:bold;">Taxes:</span></td>
                                    <td style="width: 10%;" align="right" t-out="format_amount(object.sale_id.amount_tax, object.sale_id.currency_id) or ''">$ 0.00</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%"/>
                                    <td style="width: 30%; border-top: 1px solid #dee2e6;" align="right"><span style="font-weight:bold;">Total:</span></td>
                                    <td style="width: 10%; border-top: 1px solid #dee2e6;" align="right" t-out="format_amount(object.sale_id.amount_total, object.sale_id.currency_id) or ''">$ 10.00</td>
                                </tr>
                            </table>
                        </div>
                        <div t-if="object.sale_id.partner_invoice_id" style="margin: 0px; padding: 0px;">
                            <table width="100%" style="color: #454748; font-size: 12px;">
                                <tr>
                                    <td style="padding-top: 10px;">
                                        <span style="font-weight:bold;">Bill to:</span>
                                        <t t-out="object.sale_id.partner_invoice_id.street or ''">1201 S Figueroa St</t>
                                        <t t-out="object.sale_id.partner_invoice_id.city or ''">Los Angeles</t>
                                        <t t-out="object.sale_id.partner_invoice_id.state_id.name or ''">California</t>
                                        <t t-out="object.sale_id.partner_invoice_id.zip or ''">90015</t>
                                        <t t-out="object.sale_id.partner_invoice_id.country_id.name or ''">United States</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span style="font-weight:bold;">Payment Method:</span>
                                        <t t-if="tx_sudo.token_id">
                                            <t t-out="tx_sudo.token_id.display_name or ''"></t>
                                        </t>
                                        <t t-else="">
                                            <t t-out="tx_sudo.provider_id.sudo().name or ''"></t>
                                        </t>
                                        (<t t-out="format_amount(tx_sudo.amount, object.sale_id.currency_id) or ''">$ 10.00</t>)
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div t-if="object.sale_id.partner_shipping_id and not object.sale_id.only_services" style="margin: 0px; padding: 0px;">
                            <table width="100%" style="color: #454748; font-size: 12px;">
                                <tr>
                                    <td>
                                        <br/>
                                        <span style="font-weight:bold;">Ship to:</span>
                                        <t t-out="object.sale_id.partner_shipping_id.street or ''">1201 S Figueroa St</t>
                                        <t t-out="object.sale_id.partner_shipping_id.city or ''">Los Angeles</t>
                                        <t t-out="object.sale_id.partner_shipping_id.state_id.name or ''">California</t>
                                        <t t-out="object.sale_id.partner_shipping_id.zip or ''">90015</t>
                                        <t t-out="object.sale_id.partner_shipping_id.country_id.name or ''">United States</t>
                                    </td>
                                </tr>
                            </table>
                            <table t-if="hasattr(object.sale_id, 'carrier_id') and object.sale_id.carrier_id" width="100%" style="color: #454748; font-size: 12px;">
                                <tr>
                                    <td>
                                        <span style="font-weight:bold;">Shipping Method:</span>
                                        <t t-out="object.sale_id.carrier_id.name or ''"></t>
                                        <t t-if="object.sale_id.amount_delivery == 0.0">
                                            (Free)
                                        </t>
                                        <t t-else="">
                                            (<t t-out="format_amount(object.sale_id.amount_delivery, object.sale_id.currency_id) or ''">$ 10.00</t>)
                                        </t>
                                    </td>
                                </tr>
                                <tr t-if="object.sale_id.carrier_id.carrier_description">
                                    <td>
                                        <strong>Shipping Description:</strong>
                                        <t t-out="object.sale_id.carrier_id.carrier_description"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
